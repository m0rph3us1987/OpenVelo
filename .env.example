# OpenVelo environment configuration
# Copy this file to .env and fill in your values.
# The .env file is NOT committed to git.

# ── Host data directory (persistent data — survives container upgrades) ────────
#
# A single directory on your host machine that OpenVelo will use for:
#   - openvelo.sqlite  (the database)
#   - temp_data/          (git clones, story files, agent working data)
#
# The directory must exist before running `docker compose up`.
# Linux example:   OPENVELO_DATA_DIR=/home/yourname/openvelo
# Windows example: OPENVELO_DATA_DIR=C:\Users\yourname\openvelo
OPENVELO_DATA_DIR=
