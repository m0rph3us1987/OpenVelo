# OpenVelo tester_rewrite — debug-mode environment configuration
#
# In debug mode (TESTER_DEBUG=true) the orchestrator is NOT running, so
# no handshake is sent. Every field the orchestrator would normally send
# is read from these DEBUG_* environment variables instead.
#
# Copy this file to .env and fill in your values.
# The .env file is NOT committed to git.
#
# Usage:
#   docker compose --env-file .env up -d
# (docker-compose.yml mounts .env via the `env_file:` directive.)
#
# Only the fields actually used by debug mode are listed below. Leave a
# field blank to skip the corresponding setup step.
#
# ── Required to actually run a test ────────────────────────────────────────
#
# Git URL of the project under test (https or git@… form).
DEBUG_REPO_URL=
# Git host preset (e.g. "github", "gitlab"). Default: github.
DEBUG_REPO_HOST=github
# Personal access token, if the repo is private. Leave blank for public repos.
DEBUG_REPO_PAT=
# Branch / ref to check out. Leave blank to use the repo's default branch.
DEBUG_REPO_BRANCH=
# AI backend identifier passed to kilo (e.g. "anthropic", "openai", "kilo").
DEBUG_BACKEND=
# Model ID used for the test execution turn (e.g. "anthropic/claude-sonnet-4-6").
DEBUG_EXECUTION_MODEL=
# The test plan itself — free-form markdown / text describing what to test.
DEBUG_TEST_PLAN=

# ── Optional setup hooks ────────────────────────────────────────────────────
#
# Shell command to build the project inside /repo before testing.
# Leave blank to skip.
DEBUG_BUILD_CMD=
# Shell command to run a pre-flight test (e.g. "npm test"). Leave blank to skip.
DEBUG_TEST_CMD=
# Display title for the run (logged in the keepalive banner). Optional.
DEBUG_JOB_TITLE=
# Story / context text shown to the test agent. Optional.
DEBUG_STORY=
# Per-turn inactivity timeout for the ACP session, in seconds. Default 180.
DEBUG_AGENT_MAX_TIMEOUT=180

# ── Display / network ──────────────────────────────────────────────────────
#
# Xvfb display number (must start with ':').
DEBUG_DISPLAY=:99
# Frame buffer geometry.
DEBUG_SCREEN_W=1280
DEBUG_SCREEN_H=1024
# 8 / 16 / 24 / 32
DEBUG_SCREEN_DEPTH=24
# Listening ports for x11vnc, the keepalive HTTP server, and the MCP
# server. Must all differ.
DEBUG_PORT_VNC=5900
DEBUG_TESTER_PORT=8081
# Controller MCP server — started by entrypoint.sh BEFORE the workflow
# runs, reachable at http://${DEBUG_MCP_HOST}:${DEBUG_MCP_PORT}/{mcp,sse}.
# In debug mode you can drive it directly with curl / wscat / MCP
# Inspector. Set DEBUG_MCP_TRANSPORT=stdio to fall back to per-session
# stdio spawning (kilo acp launches the python process itself).
DEBUG_MCP_TRANSPORT=streamable-http
DEBUG_MCP_HOST=0.0.0.0
DEBUG_MCP_PORT=8765

# ── Debug-mode flags ───────────────────────────────────────────────────────
#
# Set TESTER_DEBUG=true to start the container in debug mode: the
# workflow runs the setup stage and then parks on a keepalive HTTP
# server. Attach with `docker exec -it <container> bash` to inspect.
TESTER_DEBUG=true
# When TESTER_DEBUG=true, x11vnc starts in interactive (non-view-only)
# mode by default. Set VNC_VIEW_ONLY=true to force view-only mode even
# in debug.
VNC_VIEW_ONLY=false